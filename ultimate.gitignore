node_modules/
/dist/
/dist-ssr/
/build/
/out/
/coverage/
.nyc_output
*.tsbuildinfo
.eslintcache
.parcel-cache
*.local

# Frameworks — each taken from the vendor's own template.
# Next.js REVERSED its next-env.d.ts guidance: "Add it to .gitignore. If your
# project already tracks the file, remove it from Git." Keep it in tsconfig.
/.next/
next-env.d.ts
/.nuxt/
/.output/
/.nitro/
/.svelte-kit/
/.astro/
/.react-router/
# Angular ignores /.angular/cache, NOT /.angular/. Be precise.
/.angular/cache
/.docusaurus/
.turbo
.vercel
.netlify
# Cloudflare has the strongest wording of any deploy tool: the local persistence
# folder "should be added to your .gitignore to avoid committing local
# development data."
.wrangler/

# Yarn Berry — NON-zero-installs variant. If you use Zero-Installs, swap for:
#   .yarn/*  !.yarn/cache  !.yarn/patches  !.yarn/plugins  !.yarn/releases
#   !.yarn/sdks  !.yarn/versions
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# COMMIT every lockfile — package-lock.json, pnpm-lock.yaml, yarn.lock, bun.lock.
# Yarn is explicit: "should always be stored within your repository (even if you
# develop a library)." The "libraries shouldn't" belief is a misreading of npm's
# rule about PUBLISHING npm-shrinkwrap.json, which is a different thing.


# ==============================================================================
#  11. DATASETS
#  Scope by PATH, never by extension. *.csv eats fixtures, seeds and golden files.
#  Git negation cannot re-include anything under an excluded directory — and even
#  `dir/**` breaks it unless you also add `!dir/**/`. Hence the /** form below,
#  which is the only shape that keeps .gitkeep alive.
# ==============================================================================

/data/raw/**
!/data/raw/.gitkeep
/data/interim/**
!/data/interim/.gitkeep
/data/external/**
!/data/external/.gitkeep
# Cookiecutter Data Science ships `/data/` with no negations AND ships .gitkeep
# files — so its own data tree does not survive a fresh clone. The form above
# fixes that bug. For anything over 50 MiB use Git LFS (GitHub warns at 50 MiB,
# hard-blocks at 100). A path cannot be both LFS-tracked and gitignored —
# gitignore wins and the file is never staged.

*.parquet
*.feather
*.arrow
*.orc
*.avro
# NOT ignored on purpose: *.jsonl — LLM eval sets are usually .jsonl and SHOULD
# be committed. Add it back only if yours are generated.


# ==============================================================================
#  12. OS AND EDITOR
# ==============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/mcp.json


# ==============================================================================
#  APPENDIX — .gitignore is not a security control
#
#  It only prevents FUTURE adds. A secret already committed stays in history,
#  reachable via reflog, forks, clones, PR refs and GitHub's cross-fork object
#  storage. Order of operations when one leaks:
#    1. ROTATE the secret first. Always first.
#    2. git rm --cached <path>  +  add the ignore rule
#    3. Rewrite history with git filter-repo (GitHub's current docs name
#       filter-repo v2.47+; BFG is no longer mentioned)
#    4. Contact GitHub Support to purge caches and forks
#    5. Enable push protection + gitleaks/trufflehog — those are the real control
#
#  Also: .gitignore does not stop an AI agent reading a file off disk. Agents
#  scan the filesystem, not the git index. Mirror your secret patterns into the
#  tool-native exclusion files, which are DIFFERENT per vendor:
#    Cursor      .cursorignore (blocks access) / .cursorindexingignore (index only)
#    Gemini CLI  .geminiignore          Gemini IDEs  .aiexclude
#    Windsurf    .codeiumignore         Cline  .clineignore    Roo  .rooignore
#    JetBrains   .aiignore              Copilot  server-side content exclusion only
# ==============================================================================
# ==============================================================================
#  TEAM POLICY  --  the opt-in tail
# ==============================================================================
#
#  This file TRACKS AGENTS.md, CLAUDE.md and .claude/. They are team intent,
#  Anthropic documents committing CLAUDE.md, and cloud agents, CI and review
#  bots only ever see what is committed, so a rules file that lives on one
#  laptop helps nobody else. Opting out is a policy choice, not a default.
#
#  Keeping agent rules and planning notes out of the repo? Uncomment these:
#
# AGENTS.md
# CLAUDE.md
# GEMINI.md
# plan.md
# plans/
# *.plan.md
#
#  Careful with plans: throwaway implementation notes are fine to drop, but
#  specs/, .specify/ and _bmad/ are spec-driven SOURCE OF TRUTH and are tracked
#  on purpose. A blanket plans/ can eat a team's spec directory.
#
#  Already committed one? .gitignore will not untrack it: git rm --cached <path>
#
#  EDITING THIS SECTION: everything above is still INSIDE the markers, so
#  update.sh replaces it wholesale. Rules that must survive an update belong
#  BELOW the :END marker at the bottom of this file.

# Personal document dumps: notes, PDFs, research scraps and other material that
# belongs on your disk and never in the remote. Rename to match your own folder.
myDocs/

# ==============================================================================
# <<< the-ultimate-gitignore-ai:END
